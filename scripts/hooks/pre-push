#!/usr/bin/env bash
# Opt-in local hook (install: make hooks): checks every pushed range like CI's
# test-guard job does (a Test-Change: trailer anywhere in the range is enough).
root="$(git rev-parse --show-toplevel)" || exit 0
guard="$root/scripts/test-guard.sh"
[ -x "$guard" ] || exit 0
zero=0000000000000000000000000000000000000000
rc=0
while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$local_sha" = "$zero" ] && continue   # deleting a branch
	case "$local_ref" in refs/tags/*) continue ;; esac
	base="$remote_sha"
	# A new branch (or history we don't have): "" makes the guard compare
	# with the default branch.
	if [ "$base" = "$zero" ] || ! git cat-file -e "$base^{commit}" 2>/dev/null; then
		base=""
	fi
	"$guard" "$base" "$local_sha" || rc=1
done
exit $rc
