func _ready() -> void:
	var t := Translation.new()
	t.locale = "es"
	for k in ES:
		t.add_message(k, ES[k])
	for m in Missions.LIST:
		for f in ["title", "goal", "learn"]:
			t.add_message(m[f], m[f + "_es"])
	TranslationServer.add_translation(t)
	if Settings.lang == "":
		Settings.lang = "es" if OS.get_locale_language() == "es" else "en"
	TranslationServer.set_locale(Settings.lang)


func set_lang(l: String) -> void:
	Settings.lang = l
	TranslationServer.set_locale(l)
	Settings.save()
	lang_changed.emit()


func next_lang() -> void:
	var keys := LANGS.keys()
	set_lang(keys[(keys.find(Settings.lang) + 1) % keys.size()])


## tr() for code that is not a Node (static helpers).
static func t(s: String) -> String:
	return String(TranslationServer.translate(s))
