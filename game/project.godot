; Engine configuration file.
config_version=5

[application]

config/name="KubeCraft"
config/description="Explore and operate a real Kubernetes cluster as a 3D pixel-art world."
run/main_scene="res://scenes/main.tscn"
config/icon="res://icon.svg"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.113725, 0.168627, 0.32549, 1)
boot_splash/show_image=false

[autoload]

Settings="*res://scripts/settings.gd"
I18n="*res://scripts/i18n.gd"
K8s="*res://scripts/k8s_client.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/dpi/allow_hidpi=true

[gui]

theme/default_font_antialiasing=0

[rendering]

textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.113725, 0.168627, 0.32549, 1)
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
